    {
      "name": "h8-trainer-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--mode",
        "demo",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
