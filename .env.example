# Copy to .env.local and fill in from Supabase → Project Settings.
# The publishable (anon) key is public by design; Row Level Security protects the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional: OAuth Web client ID from Google Cloud → Clients (public too). When set, the login page
# shows Google's own button and signs in with an ID token, so Google's consent screen names this
# site instead of the Supabase host. Add http://localhost:5173 to the client's JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
